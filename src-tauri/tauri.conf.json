{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Essence",
  "version": "0.3.0-alpha.0",
  "identifier": "app.essence.desktop",
  "build": {
    "beforeDevCommand": "npm run dev:web",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist/web"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Essence",
        "width": 1280,
        "height": 860,
        "minWidth": 960,
        "minHeight": 680,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "category": "Productivity",
    "copyright": "Copyright 2026 Essence",
    "shortDescription": "A lucid space for thought.",
    "longDescription": "Essence is an internal desktop preview for testing the feel of the notes, library, reader, and Composer workflows as a native app shell.",
    "targets": "all"
  }
}
